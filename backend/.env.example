# PostgreSQL 접속 정보
DATABASE_URL=postgresql://carrental_app:CHANGE_ME@localhost:5432/asan_union_carrental

# 세션 서명 비밀키 (32바이트 이상 임의 문자열)
SESSION_SECRET=CHANGE_ME

# 개인정보 컬럼 암호화 키 (base64 인코딩된 32바이트 값). 생성 예:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=CHANGE_ME

# 서버 포트
PORT=4200
NODE_ENV=development

# 프론트엔드 오리진 (CORS 허용, 로컬 개발용)
FRONTEND_ORIGIN=http://localhost:5190

# 관리자 로그인 실패 잠금 정책
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
